<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <LangVersion>latest</LangVersion>
        <CelestePath>..\..\..</CelestePath>
        <TargetFramework>net8.0</TargetFramework>
        <OutputPath>bin</OutputPath>
        <PackageId>RushHelper</PackageId>
        <RootNamespace>RushHelper</RootNamespace>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="MonoMod" Version="22.7.31.1" />
        <PackageReference Include="MonoMod.RuntimeDetour" Version="25.3.3" PrivateAssets="all" ExcludeAssets="runtime">
          <IncludeAssets>compile; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="CelesteMod.Publicizer" Version="*" CelesteAssembly="$(CelestePath)\Celeste.dll" />
        <Reference Include="FNA">
            <HintPath>$(CelestePath)\FNA.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="MMHOOK_Celeste">
            <HintPath>$(CelestePath)\MMHOOK_Celeste.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>
    <ItemGroup>
      <ReferencePathWithRefAssemblies Update="C:\Users\domia\.nuget\packages\mono.cecil\0.11.5\lib\netstandard2.0\Mono.Cecil.dll" />
      <ReferencePathWithRefAssemblies Update="C:\Users\domia\AppData\Local\Temp\Celeste-publicized.dll" />
    </ItemGroup>
</Project>
